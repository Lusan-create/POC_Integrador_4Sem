# Copie para .env e ajuste os valores. O .env NÃO deve ir para o Git.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
# Usado só com DJANGO_DEBUG=false (em desenvolvimento qualquer host é aceito).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,192.168.0.10

DB_NOME=gestao_ativos
DB_USUARIO=gestao_ativos
DB_SENHA=troque-esta-senha
DB_HOST=localhost
DB_PORTA=5432

CORS_ORIGENS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACESSO_MINUTOS=60
JWT_RENOVACAO_DIAS=1
LIMITE_LOGIN=10/min
